# Aegis edge — base Caddyfile (static). The node-agent writes per-customer site
# blocks into /etc/caddy/sites/*.caddy and runs `caddy reload`.
{
	admin 127.0.0.1:2019
	email {$ACME_EMAIL}

	# Handler order for third-party + custom directives (request flow):
	# fingerprint → rate limit → WAF (hard-block attacks) → bot score →
	# challenge (suspicious-but-clean only) → cache → proxy.
	order ja4 first
	order rate_limit after ja4
	order coraza_waf after rate_limit
	order botscore after coraza_waf
	order challenge after botscore
	order cache after challenge

	# Souin/cache-handler global init (in-memory by default; Redis is a tuning step).
	cache {
		ttl 60s
	}
}

# Control-plane site (dashboard + API). All-in-one deployments only; on real
# edge nodes CONTROL_PLANE_HOST is unset and this block is skipped by Caddy.
# CP_TLS is "internal" (self-signed, default) or an email address to obtain a
# trusted cert via ACME for a real CONTROL_PLANE_HOST.
#
# The dashboard/API gets the same edge protections as onboarded domains
# (JA4 fingerprinting, per-IP rate limiting, bot scoring, Coraza/OWASP-CRS WAF),
# tunable via CP_* env. Endpoints hit by non-browser clients — the edge agents
# (/edge/*), the enrollment script served over /install/*, and /healthz — bypass
# the bot/WAF handling so they are never challenged or blocked.
{$CONTROL_PLANE_HOST:localhost} {
	tls {$CP_TLS:internal}

	handle /edge/* {
		reverse_proxy {$CP_API_UPSTREAM:api:8080}
	}
	handle /install/* {
		reverse_proxy {$CP_API_UPSTREAM:api:8080}
	}
	handle /healthz {
		reverse_proxy {$CP_API_UPSTREAM:api:8080}
	}

	handle {
		# TLS/HTTP fingerprint (also feeds analytics + bot scoring).
		ja4

		# Per-source-IP request cap (uses the real client IP, not a spoofable
		# X-Forwarded-For). CP_RATE_LIMIT_RPM requests per minute, then 429.
		# Deliberately high (~200 req/s) so a full dashboard reload — dozens of
		# JS/CSS/API requests — and even furious F5-mashing or many users behind
		# one NAT never trip it; this is a volumetric backstop, with nftables and
		# botscore as the finer-grained layers.
		rate_limit {
			zone control_plane {
				key {http.request.remote_ip}
				events {$CP_RATE_LIMIT_RPM:12000}
				window 1m
			}
		}

		# Behavioural bot scoring (blocks obvious automation; no interactive
		# challenge so legitimate admins are never interrupted).
		botscore {
			sensitivity {$CP_BOT_SENSITIVITY:low}
		}

		# Coraza + OWASP CRS. Defaults to DetectionOnly so the in-dashboard
		# WAF-rule editor (which legitimately posts SecLang) is not blocked;
		# set CP_WAF_ENGINE=On to actively block attacks on the dashboard/API.
		coraza_waf {
			directives `
				Include /etc/caddy/coraza/coraza.conf
				Include /etc/caddy/coraza/crs-setup.conf
				Include /etc/caddy/coraza/rules/*.conf
				SecRuleEngine {$CP_WAF_ENGINE:DetectionOnly}
			`
		}

		handle /api/* {
			reverse_proxy {$CP_API_UPSTREAM:api:8080}
		}
		handle {
			reverse_proxy {$CP_DASH_UPSTREAM:dashboard:3000}
		}
	}
}

# Dynamic per-customer sites rendered by the control plane.
import /etc/caddy/sites/*.caddy
