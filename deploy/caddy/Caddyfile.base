# Aegis edge — base Caddyfile (static). The node-agent writes per-customer site
# blocks into /etc/caddy/sites/*.caddy and runs `caddy reload`.
{
	admin 127.0.0.1:2019
	email {$ACME_EMAIL}

	# Handler order for third-party + custom directives (request flow):
	# fingerprint → rate limit → WAF (hard-block attacks) → bot score →
	# challenge (suspicious-but-clean only) → cache → proxy.
	order ja4 first
	order rate_limit after ja4
	order coraza_waf after rate_limit
	order botscore after coraza_waf
	order challenge after botscore
	order cache after challenge

	# Souin/cache-handler global init (in-memory by default; Redis is a tuning step).
	cache {
		ttl 60s
	}
}

# Control-plane site (dashboard + API). All-in-one deployments only; on real
# edge nodes CONTROL_PLANE_HOST is unset and this block is skipped by Caddy.
# CP_TLS is "internal" (self-signed, default) or an email address to obtain a
# trusted cert via ACME for a real CONTROL_PLANE_HOST.
#
# The dashboard/API gets the same edge protections as onboarded domains
# (JA4 fingerprinting, per-IP rate limiting, bot scoring, Coraza/OWASP-CRS WAF),
# tunable via CP_* env. Endpoints hit by non-browser clients — the edge agents
# (/edge/*), the enrollment script served over /install/*, and /healthz — bypass
# the bot/WAF handling so they are never challenged or blocked.
{$CONTROL_PLANE_HOST:localhost} {
	tls {$CP_TLS:internal}

	handle /edge/* {
		reverse_proxy {$CP_API_UPSTREAM:api:8080}
	}
	handle /install/* {
		reverse_proxy {$CP_API_UPSTREAM:api:8080}
	}
	handle /healthz {
		reverse_proxy {$CP_API_UPSTREAM:api:8080}
	}

	handle {
		# Explicit-order route: the cheap "under attack" gate must reject floods
		# BEFORE the expensive OWASP-CRS WAF, bot scoring and per-request analytics
		# run — otherwise every flood request pays for all of that before being
		# challenged, spiking CPU. `route` executes in written order, unlike the
		# global order customer sites rely on (where challenge follows bot scoring).
		route {
			# Per-source-IP volumetric cap (real client IP, not a spoofable
			# X-Forwarded-For). Deliberately high (~200 req/s) so reloads, F5-mashing
			# and many users behind one NAT never trip it; nftables + the gate below
			# are the finer layers.
			rate_limit {
				zone control_plane {
					key {http.request.remote.host}
					events {$CP_RATE_LIMIT_RPM:12000}
					window 1m
				}
			}

			# "Under attack" proof-of-work gate — runs early so an uncleared flood
			# gets a cheap interstitial / auto-ban 429 without touching the WAF,
			# bot scorer, analytics or backend. Default "auto" is controllable live
			# from the dashboard (Admin toggle); force with CP_UNDER_ATTACK=on or
			# disable with =off. Real browsers solve it once (1h clearance cookie)
			# and fall through to the full stack below; browser-spoofing floods that
			# don't run JS can't pass, and repeat offenders are auto-banned.
			challenge {
				secret {env.CHALLENGE_SECRET}
				under_attack {$CP_UNDER_ATTACK:auto}
			}

			# TLS/HTTP fingerprint + per-request analytics — only for requests that
			# clear the gate, so a flood can't also flood the analytics pipeline.
			ja4

			# Coraza + OWASP CRS. DetectionOnly by default so the in-dashboard
			# WAF-rule editor (which posts SecLang) isn't blocked; CP_WAF_ENGINE=On
			# to actively block attacks on the dashboard/API.
			coraza_waf {
				directives `
					Include /etc/caddy/coraza/coraza.conf
					Include /etc/caddy/coraza/crs-setup.conf
					Include /etc/caddy/coraza/rules/*.conf
					SecRuleEngine {$CP_WAF_ENGINE:DetectionOnly}
				`
			}

			# Behavioural bot scoring (blocks obvious automation).
			botscore {
				sensitivity {$CP_BOT_SENSITIVITY:low}
			}

			handle /api/* {
				reverse_proxy {$CP_API_UPSTREAM:api:8080}
			}
			handle {
				reverse_proxy {$CP_DASH_UPSTREAM:dashboard:3000}
			}
		}
	}
}

# Dynamic per-customer sites rendered by the control plane.
import /etc/caddy/sites/*.caddy
